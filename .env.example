# Copy to `.env.local` (preferred) or `.env` in this directory, then fill in values.
# `.env.local` overrides `.env` and is ignored by git.

# YouTube Data API v3 key — used only when yt-dlp cannot list channel uploads.
# Create at: https://console.cloud.google.com/apis/credentials
# Enable: YouTube Data API v3
YOUTUBE_API_KEY=

# Optional transcript fetch proxies (channel CLI + web worker read these server-side).
# Residential rotating proxies are the reliable fix for YouTube IP blocks — see README:
# https://github.com/jdepoix/youtube-transcript-api?tab=readme-ov-file#working-around-ip-bans-requestblocked-or-ipblocked-exception
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Channel export only: urllib retries per transcript on 429 (default 2; library default is 10)
WEBSHARE_PROXY_RETRIES=2
HTTP_PROXY=
HTTPS_PROXY=
